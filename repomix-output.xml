import { useEffect, useState } from 'react'
import './App.css'

type Scenario = {
  description: string
  lead_id: string
}

type Scenarios = Record<string, Scenario>

type AgentOutput = {
  agent_name: string
  status?: string
  validated_lead?: Record<string, unknown> | null
  errors?: string[]
  score?: number
  days_since_last_contact?: number | null
  event_count?: number
  recognized_events?: string[]
  reason?: string
  fit_score?: number
  sla_flags?: string[]
  priority_score?: number
  action?: string
  triggered_rules?: string[]
  reasons?: string[]
}

type WorkflowContext = {
  workflow_id: string
  started_at: string
  lead_record: Record<string, unknown>
  engagement_events: Array<Record<string, unknown>>
  validated_lead: Record<string, unknown> | null
  recency_score: number | null
  engagement_score: number | null
  fit_score: number | null
  sla_flags: string[]
  agent_outputs: Record<string, AgentOutput>
  final_recommendation: Recommendation | null
  explanation: Record<string, unknown> | null
  audit_reference: string | null
  errors: string[]
}

type Recommendation = {
  priority_score: number
  action: string
  triggered_rules: string[]
  reasons: string[]
}

type AuditRecord = {
  audit_reference: string
  workflow_id: string
  timestamp: string
  lead_id: string
  agent_sequence: string[]
  agent_outputs: Record<string, AgentOutput>
  triggered_rules: string[]
  final_recommendation: Recommendation
  execution_trace: Array<{
    node: string
    status: string
    provider?: string
    model?: string
    reason?: string
    route?: string
    condition?: string
  }>
  errors: string[]
}

type WorkflowResult = {
  workflow_id: string
  scenario?: string
  lead_id: string
  recommendation: Recommendation
  explanation: {
    summary: string
    executed_agents: string[]
    score_breakdown: {
      recency: number | null
      engagement: number | null
      fit: number | null
    }
    triggered_rules: string[]
    reasons: string[]
    limitations: string[]
  }
  audit_reference: string
  workflow_context: WorkflowContext
  audit_record: AuditRecord | null
  errors: string[]
}

const agentDefinitions: Record<
  string,
  {
    responsibility: string
    input: string
  }
> = {
  lead_intake: {
    responsibility: 'Validates mandatory lead fields and normalizes lead information.',
    input: 'Lead record',
  },
  recency: {
    responsibility: 'Evaluates how recently the lead was contacted.',
    input: 'Validated lead and last-contact date',
  },
  engagement: {
    responsibility: 'Scores recognized business engagement events.',
    input: 'Validated lead and engagement events',
  },
  fit_sla: {
    responsibility: 'Evaluates declared business need and pending follow-up SLA.',
    input: 'Validated lead and follow-up information',
  },
  lead_priority: {
    responsibility: 'Combines agent scores and business rules into a recommendation.',
    input: 'Recency, engagement, fit and SLA outputs',
  },
}

const agentOrder = [
  'lead_intake',
  'recency',
  'engagement',
  'fit_sla',
  'lead_priority',
]

const actionLabels: Record<string, string> = {
  FOLLOW_UP_NOW: 'Follow Up Now',
  FOLLOW_UP_SOON: 'Follow Up Soon',
  NURTURE: 'Nurture',
  REQUEST_DATA: 'Request Data',
}

const actionDescriptions: Record<string, string> = {
  FOLLOW_UP_NOW:
    'This lead needs prompt attention. Review the available evidence and arrange the next follow-up.',
  FOLLOW_UP_SOON:
    'This lead should remain in the active follow-up queue. Schedule the next contact soon.',
  NURTURE:
    'This lead is better suited to continued engagement. Keep it in the nurture process and review it later.',
  REQUEST_DATA:
    'Some mandatory lead information is missing. Complete the required information before prioritization can continue.',
}

const nextActions: Record<string, string> = {
  FOLLOW_UP_NOW:
    'Contact the lead as soon as practical. Review the declared need and agree on the next step.',
  FOLLOW_UP_SOON:
    'Schedule a follow-up within your team’s normal response window and keep the lead on the active list.',
  NURTURE:
    'Add the lead to the appropriate nurture queue and plan a future engagement review.',
  REQUEST_DATA:
    'Ask the responsible team member to provide the missing contact or lead information, then reassess.',
}

function formatValue(value: unknown): string {
  if (value === null || value === undefined || value === '') {
    return 'Not provided'
  }

  if (typeof value === 'boolean') {
    return value ? 'Yes' : 'No'
  }

  if (typeof value === 'object') {
    return JSON.stringify(value, null, 2)
  }

  return String(value)
}

function formatDate(value: unknown): string {
  if (!value || typeof value !== 'string') return 'Not provided'

  const date = new Date(value)

  if (Number.isNaN(date.getTime())) return value

  return date.toLocaleString()
}

