<file path="backups/phase-2/App.css">
:root {
  --navy: #080f1e;
  --surface: #111d32;
  --surface-raised: #1a2945;
  --surface-soft: #202f4b;
  --gold: #d5a62e;
  --gold-soft: rgba(213, 166, 46, 0.13);
  --text: #f5f3ed;
  --muted: #aab6c9;
  --border: #34445f;
  --success: #72c6a0;
  --danger: #e58d8d;
  --shadow: 0 16px 36px rgba(0, 0, 0, 0.2);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--navy);
  color: var(--text);
  font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
}

button {
  font: inherit;
}

.app-shell {
  min-height: 100vh;
  background: var(--navy);
}

.topbar {
  min-height: 82px;
  padding: 16px max(5%, calc((100% - 1320px) / 2));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  background: #060c18;
  border-bottom: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 13px;
}

.brand-mark {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: var(--gold);
  color: var(--navy);
  font-size: 23px;
  font-weight: 850;
}

.brand h1 {
  margin: 0;
  color: var(--text);
  font-size: 21px;
  letter-spacing: 2px;
}

.brand p {
  margin: 2px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.system-status {
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--muted);
  font-size: 13px;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 10px rgba(114, 198, 160, 0.4);
}

.page-content {
  width: min(1320px, 90%);
  margin: 0 auto;
  padding: 42px 0 70px;
}

.page-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  margin-bottom: 30px;
}

.page-heading h2 {
  max-width: 800px;
  margin: 9px 0;
  color: var(--text);
  font-size: clamp(27px, 4vw, 38px);
  line-height: 1.2;
  letter-spacing: -1px;
}

.eyebrow {
  margin: 0 0 9px;
  color: var(--gold);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.subtitle,
.section-heading p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.6;
}

.version-tag,
.scenario-count {
  flex-shrink: 0;
  padding: 8px 12px;
  border: 1px solid var(--border);
  border-radius: 7px;
  color: var(--gold);
  background: var(--surface);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.scenario-panel,
.result-panel,
.audit-panel {
  margin-bottom: 22px;
  padding: 25px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 22px;
}

.section-heading h3,
.result-panel h3,
.audit-panel h3 {
  margin: 0;
  color: var(--text);
  font-size: 21px;
  line-height: 1.35;
}

.scenario-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.scenario-card {
  min-width: 0;
  padding: 18px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 9px;
  text-align: left;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface-raised);
  color: var(--text);
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s, transform 0.2s;
}

.scenario-card:hover {
  border-color: var(--gold);
  transform: translateY(-2px);
}

.scenario-card.selected {
  border-color: var(--gold);
  background: var(--gold-soft);
  box-shadow: inset 0 0 0 1px var(--gold);
}

.scenario-name {
  color: var(--gold);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
}

.scenario-card strong {
  font-size: 14px;
  overflow-wrap: anywhere;
}

.scenario-description {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
}

.run-row {
  margin-top: 23px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  color: var(--muted);
  font-size: 13px;
}

.run-button {
  min-height: 45px;
  padding: 0 19px;
  display: inline-flex;
  align-items: center;
  gap: 16px;
  border: 0;
  border-radius: 8px;
  background: var(--gold);
  color: #111827;
  font-weight: 800;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}

.run-button:hover:not(:disabled) {
  background: #e6bd51;
  transform: translateY(-1px);
}

.run-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.result-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 16px;
}

.recommendation-card,
.score-card {
  min-width: 0;
  padding: 23px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: var(--surface-raised);
}

.recommendation-card {
  border-left: 4px solid var(--gold);
}

.metric-label {
  color: var(--muted);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

.recommendation-card h2 {
  margin: 13px 0 9px;
  color: var(--gold);
  font-size: clamp(23px, 3vw, 32px);
}

.recommendation-card p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

.score-value {
  margin: 14px 0;
  color: var(--gold);
  font-size: 43px;
  font-weight: 800;
}

.score-value small {
  margin-left: 4px;
  color: var(--muted);
  font-size: 15px;
}

.score-track {
  height: 8px;
  overflow: hidden;
  border-radius: 20px;
  background: #34445f;
}

.score-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--gold);
  transition: width 0.4s ease;
}

.completed-tag,
.agent-status {
  padding: 6px 10px;
  border-radius: 20px;
  background: rgba(114, 198, 160, 0.12);
  color: var(--success);
  font-size: 10px;
  font-weight: 800;
}

.breakdown-section,
.rules-section {
  margin-top: 25px;
}

.result-panel h4,
.audit-panel h4 {
  margin: 23px 0 12px;
  color: var(--text);
  font-size: 14px;
}

.breakdown-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.breakdown-item,
.context-item,
.data-item {
  min-width: 0;
  padding: 15px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: var(--surface-raised);
}

.breakdown-item {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  color: var(--muted);
  text-transform: capitalize;
}

.breakdown-item strong {
  color: var(--gold);
}

.rule-list {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.rule-tag {
  padding: 7px 11px;
  border: 1px solid rgba(213, 166, 46, 0.45);
  border-radius: 6px;
  background: var(--gold-soft);
  color: var(--gold);
  font-size: 11px;
  font-weight: 750;
  overflow-wrap: anywhere;
}

.input-grid,
.context-grid,
.context-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.context-meta {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-bottom: 13px;
}

.data-item,
.context-item {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.data-item span,
.context-item span,
.agent-detail-grid span,
.audit-details span {
  color: var(--muted);
  font-size: 11px;
  font-weight: 650;
}

.data-item strong,
.context-item strong,
.agent-detail-grid strong,
.audit-details strong {
  color: var(--text);
  font-size: 13px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.context-item strong {
  color: var(--gold);
  font-size: 18px;
}

.event-list {
  display: grid;
  gap: 9px;
}

.event-row {
  padding: 13px 15px;
  display: grid;
  grid-template-columns: 1fr 1fr 1.5fr;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--surface-raised);
}

.event-row strong {
  color: var(--gold);
  font-size: 13px;
}

.event-row span,
.event-row small {
  color: var(--muted);
  font-size: 11px;
  overflow-wrap: anywhere;
}

.context-updates {
  display: grid;
  gap: 10px;
}

.context-updates div {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--surface-raised);
  color: var(--text);
  font-size: 13px;
  overflow-wrap: anywhere;
}

.context-updates span {
  color: var(--gold);
  font-weight: 800;
}

.context-note {
  margin-top: 17px;
}

.muted-text {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.workflow-line {
  display: grid;
  gap: 15px;
}

.agent-card {
  min-width: 0;
  padding: 19px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface-raised);
}

.agent-executed {
  border-left: 3px solid var(--success);
}

.agent-skipped {
  border-left: 3px solid #68758a;
  opacity: 0.75;
}

.agent-card-heading {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.agent-number {
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: var(--gold-soft);
  color: var(--gold);
  font-size: 12px;
  font-weight: 800;
}

.agent-card-heading > div {
  flex: 1;
  min-width: 0;
}

.agent-card-heading h4 {
  margin: 2px 0 5px;
  color: var(--text);
  font-size: 14px;
}

.agent-card-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.55;
}

.agent-skipped-status {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 10px;
  font-weight: 750;
}

.agent-detail-grid {
  margin: 17px 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.agent-detail-grid > div {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.agent-card h5 {
  margin: 17px 0 9px;
  color: var(--gold);
  font-size: 11px;
  letter-spacing: 0.5px;
}

.json-output {
  max-width: 100%;
  margin: 0;
  padding: 16px;
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #080f1e;
  color: #d6dfec;
  font-family: "Cascadia Code", Consolas, monospace;
  font-size: 11px;
  line-height: 1.65;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.reason-list {
  margin: 0;
  padding-left: 21px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.8;
}

.explanation-text {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.75;
}

.audit-details {
  margin-top: 22px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.audit-details > div {
  min-width: 0;
  padding: 15px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: var(--surface-raised);
}

.audit-details strong {
  font-family: "Cascadia Code", Consolas, monospace;
  font-size: 11px;
}

.error-message {
  margin: 18px 0;
  padding: 13px 16px;
  border: 1px solid rgba(229, 141, 141, 0.4);
  border-radius: 8px;
  background: rgba(229, 141, 141, 0.1);
  color: var(--danger);
  font-size: 13px;
  line-height: 1.6;
}
.validation-message {
  margin: 18px 0;
  padding: 13px 16px;
  border: 1px solid rgba(213, 166, 46, 0.4);
  border-radius: 8px;
  background: rgba(213, 166, 46, 0.08);
  color: #e7c66f;
  font-size: 13px;
  line-height: 1.6;
}
.empty-state {
  padding: 65px 25px;
  text-align: center;
  border: 1px dashed var(--border);
  border-radius: 14px;
  background: var(--surface);
}

.empty-icon {
  width: 48px;
  height: 48px;
  margin: 0 auto 16px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--gold-soft);
  color: var(--gold);
  font-size: 25px;
}

.empty-state h3 {
  color: var(--text);
}

.empty-state p {
  max-width: 570px;
  margin: 0 auto;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.footer {
  min-height: 65px;
  padding: 18px 5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  border-top: 1px solid var(--border);
  background: #060c18;
  color: var(--muted);
  font-size: 11px;
}

@media (max-width: 850px) {
  .page-content {
    width: 92%;
    padding-top: 30px;
  }

  .scenario-grid,
  .input-grid,
  .context-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .result-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .topbar {
    padding: 14px 4%;
  }

  .system-status {
    font-size: 10px;
  }

  .page-content {
    width: 92%;
    padding: 25px 0 45px;
  }

  .page-heading {
    flex-direction: column;
  }

  .page-heading h2 {
    font-size: 27px;
  }

  .scenario-panel,
  .result-panel,
  .audit-panel {
    padding: 17px;
    border-radius: 11px;
  }

  .scenario-grid,
  .input-grid,
  .context-grid,
  .context-meta,
  .breakdown-grid,
  .audit-details {
    grid-template-columns: 1fr;
  }

  .section-heading {
    flex-direction: column;
  }

  .run-row {
    align-items: stretch;
    flex-direction: column;
  }

  .run-button {
    justify-content: center;
  }

  .event-row {
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .agent-card-heading {
    flex-wrap: wrap;
  }

  .agent-card-heading > div {
    flex-basis: calc(100% - 50px);
  }

  .agent-detail-grid {
    grid-template-columns: 1fr;
  }

  .footer {
    align-items: flex-start;
    flex-direction: column;
  }
}
