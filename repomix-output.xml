        const data: Scenarios = await response.json()
        setScenarios(data)
      } catch {
        setError(
          'Could not connect to the backend. Please check that the API server is running.',
        )
      }
    }

    loadScenarios()
  }, [])

  async function runScenario() {
    setLoading(true)
